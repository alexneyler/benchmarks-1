{
  "name": "@computesdk/remotion-video",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/prepare.ts",
    "typecheck": "tsc --noEmit",
    "dev": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx BenchmarkLeaderboard out.mp4",
    "render:png": "remotion still src/index.tsx BenchmarkLeaderboard out.png --frame=840"
  },
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
